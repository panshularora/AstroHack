{
  "compilerOptions": {
    "strict": false,
    "noCheck": true,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"]
}
