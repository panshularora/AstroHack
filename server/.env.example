# Real UPI via Razorpay (GPay, PhonePe, Paytm, BHIM).
# Dashboard: https://dashboard.razorpay.com → API Keys
# rzp_live_… for live rupees. rzp_test_… for sandbox (success@razorpay).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same string in Razorpay Dashboard → Webhooks → /api/pay/upi/webhook (payment.captured)
RAZORPAY_WEBHOOK_SECRET=
# Signed WebRTC room tokens (do not leave default)
RTC_SECRET=
# Optional. Ask uses xAI when set. App still runs without it.
XAI_API_KEY=
# Optional. Video on bad Wi-Fi. App still runs on STUN without it.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
